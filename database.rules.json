// Realtime Database güvenlik kuralları. Ne yaptığı, ne yapmadığı ve nasıl
// yayınlandığı README.md → "Firebase güvenlik kuralları" bölümünde.
// Konsola yapıştırdıktan sonra: son satır 65 ve tek bir } olmalı.
{
  "rules": {
    ".read": false,
    ".write": false,

    "kayitlar": {
      ".read": "auth != null",

      "$kayitId": {
        // Yalnız ekleme: data.exists() ise (kayıt zaten varsa) yazma reddedilir.
        // newData.exists() şartı da silmeyi engeller.
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['id','type','createdAt'])",

        "id":        { ".validate": "newData.isNumber()" },
        "type":      { ".validate": "newData.isString() && newData.val().length <= 16" },
        "text":      { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "mudur":     { ".validate": "newData.isString() && newData.val().length <= 80" },
        "mudurId":   { ".validate": "newData.isString() && newData.val().length <= 40" },

        "items": {
          "$sira": {
            ".validate": "newData.hasChildren(['amount'])",
            "amount":   { ".validate": "newData.isNumber()" },
            "category": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "known":    { ".validate": "newData.isString() && newData.val().length <= 120" },
            "grup":     { ".validate": "newData.isString() && newData.val().length <= 120" },
            "raw":      { ".validate": "newData.isString() && newData.val().length <= 300" },
            "anomali":  { ".validate": "newData.isBoolean()" },
            // Uygulamaya ileride alan eklenirse senkron sessizce durmasın.
            "$diger":   { ".validate": true }
          }
        },

        "$diger": { ".validate": true }
      }
    },

    // Şantiye / fabrika / halısaha tanımları ve müdür atamaları.
    // Kayıtların aksine BURASI GÜNCELLENEBİLİR: bir müdür başka yere
    // atandığında var olan kayıt değişir. O yüzden "yalnız ekleme" kuralı
    // burada geçerli değil.
    // Patron yazar, herkes okur — ama anonim girişte kuralın patronu
    // ayırt etme imkânı yok; "yalnız patron yazsın" şartı uygulama
    // tarafında. Buradaki koruma veriyi bozulmaya karşı tutuyor:
    // alanların tipi ve uzunluğu sınırlı, tanınmayan alan kabul edilmiyor.
    "yerler": {
      ".read": "auth != null",
      ".write": "auth != null",

      "$yerId": {
        ".validate": "newData.hasChildren(['ad'])",
        "ad":  { ".validate": "newData.isString() && newData.val().length <= 60" },
        "tur": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "mudurIds": {
          "$sira": { ".validate": "newData.isString() && newData.val().length <= 40" }
        }
      }
    }
  }
}
